# Copy to .env.local for local dev (Vite loads .env.local automatically and
# it's gitignored). Both are optional -- if unset, the app just starts with
# blank Connection fields in the sidebar, same as the Streamlit UI does with
# no SNOWFLAKE_NL_API_URL set.
#
# Baked into the JS bundle at build time (there's no server to hold these at
# runtime, since the app calls API Gateway directly from the browser) -- so
# whatever you put here is visible to anyone who opens dist/ or the network
# tab. Fine for a dev-testing API key; don't put a production secret here.

VITE_API_URL=https://abc123.execute-api.eu-central-1.amazonaws.com/dev/query
VITE_API_KEY=
